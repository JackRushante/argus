<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wakelock parziale solo mentre una regola sta eseguendo (attese e chiamate AI a schermo
         spento): permesso normal, auto-concesso. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Telefonia (P2-2): runtime grant richiesti SOLO quando una regola li usa. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Senza READ_CALL_LOG il broadcast PHONE_STATE non porta il numero chiamante. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Connectivity BT (API 31+): grant runtime opt-in, separato da Wi-Fi/alimentazione. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 0.8: SMS e chiamate in uscita, contatti per il filtro chiamate «solo sconosciuti». Runtime grant
         richiesti SOLO quando una regola li usa (righe opt-in in Sistema). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- I permessi di telefonia la rendono implicitamente obbligatoria: Argus funziona anche senza
         (SMS, chiamate e filtro chiamate risultano non disponibili). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- 0.8, calendario (condizione calendar_busy e trigger calendar_event): grant runtime opt-in,
         chiesto solo per le regole che leggono il calendario. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Tier base senza Shizuku (P3-3): DND/Ringer via NotificationManager/AudioManager.
         Grant «Accesso Non disturbare» concesso dall'utente, non runtime. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Sveglia/timer reali via Intent AlarmClock (S1): permesso normal, auto-concesso. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Vibrazione one-shot (S4): permesso normal, auto-concesso. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package visibility minima per risolvere localmente nomi come "Google Messaggi".
         Non richiede QUERY_ALL_PACKAGES: sono visibili soltanto le app avviabili dall'utente. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 0.5.1: il launcher in uso, per rifiutare che una regola lo fermi o lo congeli. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- 0.7.0: l'app predefinita per i tipi di app con un intent standard (calcolatrice, calendario,
             contatti, email, galleria, mappe, messaggi, musica, browser) e la fotocamera, per mostrare al
             compilatore quella che l'utente usa. Solo questi intent: niente QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALCULATOR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application>
        <service
            android:name="dev.argus.automation.notification.ArgusNotificationListenerService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 0.5.1 (F17): servizio di Accessibilità per le macro sullo schermo che l'utente approva. Lo
             accende solo l'utente (o il dialogo dei permessi permanenti, con un backend privilegiato); il
             sistema lo lega grazie al permesso BIND_ACCESSIBILITY_SERVICE. Eventi minimi, nessun gesto. -->
        <service
            android:name="dev.argus.automation.screen.ArgusAccessibilityService"
            android:exported="true"
            android:label="@string/a11y51_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/argus_accessibility_service" />
        </service>

        <!-- «Ferma» della notifica della macro: intent esplicito, nessuna azione esterna. -->
        <receiver
            android:name="dev.argus.automation.screen.UiMacroStopReceiver"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name="dev.argus.automation.connectivity.ConnectivitySentinelService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user_armed_automation_trigger_monitoring_and_bounded_execution" />
        </service>

        <receiver
            android:name=".TimeAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Sveglia interna di ripresa per le attese lunghe (B19); l'intent è esplicito. -->
        <receiver
            android:name="dev.argus.automation.power.WaitWakeReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 0.8: pulsanti di «chiedimi prima» e delle domande, sveglia di scadenza. Non esportato e senza
             intent-filter: lo raggiungono solo i PendingIntent immutabili ed espliciti di Argus, con il
             token casuale della domanda. -->
        <receiver
            android:name="dev.argus.automation.prompt.UserPromptReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 0.7.2: sveglia inexact del backup automatico delle regole; intent esplicito, nessuna azione esterna. -->
        <receiver
            android:name="dev.argus.automation.backup.AutoBackupAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="dev.argus.automation.geofence.GeofenceTransitionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 0.8: ricontrollo di una geofence DWELL dopo la sua attesa; intent esplicito, nessuna azione esterna. -->
        <receiver
            android:name="dev.argus.automation.geofence.GeofenceDwellReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".TimeReconciliationReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <!-- 0.8: la prossima sveglia è cambiata (trigger next_alarm). Broadcast di sistema esente dai
                     limiti sugli implicit receiver; senza regole next_alarm il reconcile non cambia nulla. -->
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 0.8, rules active before the first unlock (opt-in per rule). The ONLY direct-boot-aware components of
             Argus, in their own process: there ArgusApplication skips its whole start-up (no Hilt graph, Room,
             preferences, Keystore or Shizuku), and they read only device-encrypted storage. Not exported: the boot
             broadcast comes from the system (a protected broadcast), the alarm from Argus's own explicit, immutable
             PendingIntent; both receivers check the action anyway. -->
        <receiver
            android:name="dev.argus.automation.directboot.LockedBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:process=":locked">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="dev.argus.automation.directboot.LockedAlarmReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:process=":locked" />

        <!-- 0.8: sveglia per regola del trigger calendario; intent esplicito, nessuna azione esterna. -->
        <receiver
            android:name="dev.argus.automation.calendar.CalendarAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 0.8: ripianifica le istanze del calendario dopo riavvio, cambio di ora o di fuso, aggiornamento. -->
        <receiver
            android:name="dev.argus.automation.calendar.CalendarReplanReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- exported richiesto dai broadcast di sistema; BROADCAST_SMS limita il mittente
             al sistema stesso (nessuna app può forgiare un SMS_RECEIVED). -->
        <receiver
            android:name="dev.argus.automation.phone.SmsBroadcastReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="dev.argus.automation.phone.PhoneStateBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- 0.8: filtro chiamate (`screen_call`). Android lo usa solo se Argus ha il ruolo «filtro
             chiamate», chiesto quando una regola lo usa; BIND_SCREENING_SERVICE: solo il sistema si lega. -->
        <service
            android:name="dev.argus.automation.telephony.ArgusCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- ACL_CONNECTED/DISCONNECTED sono broadcast protetti di sistema ed esenti dai
             limiti sugli implicit receiver. Nessun receiver manifest per POWER: non è esente. -->
        <receiver
            android:name="dev.argus.automation.connectivity.BluetoothConnectivityReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
