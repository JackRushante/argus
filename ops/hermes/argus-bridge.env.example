# Copiare come ~/argus-bridge/argus-bridge.env con mode 0600.
# Generare un token casuale; non commettere mai il valore reale.
ARGUS_BRIDGE_TOKEN=replace-with-a-random-secret
ARGUS_BRIDGE_BIND=127.0.0.1
ARGUS_BRIDGE_PORT=8092
ARGUS_MODEL=gpt-5.5
# Tetto per chiamata al modello (default del bridge senza questa riga: 90). Il client Android attende
# 125 s e un'azione generativa con ricerca web può durare oltre i 90 s: tenerli allineati.
ARGUS_MODEL_TIMEOUT_SECONDS=125
