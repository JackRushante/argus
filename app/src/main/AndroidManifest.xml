<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permission normal: consente a OkHttp/probe di interrogare ConnectivityManager. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- P1: dialogo diretto di esenzione batteria, aperto SOLO da gesto utente (CTA Settings/onboarding). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 0.4.1: «Modifica impostazioni di sistema» (permesso speciale, si concede solo dalle impostazioni
         di sistema): serve alle azioni luminosità e rotazione dello schermo. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- 0.5.0 («Shizuku una volta sola»): permessi che Argus si concede da sé con Shizuku o root, una
         volta, e che restano dopo il riavvio (`pm grant` / `appops set`). Non si concedono da nessun'altra
         parte: dichiararli non li dà. WRITE_SECURE_SETTINGS = write_setting su SECURE e GLOBAL senza Shizuku;
         PACKAGE_USAGE_STATS = la condizione «app in primo piano» senza Shizuku. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 0.4.1: package visibility per i motori di sintesi vocale (azione «leggi ad alta voce»);
         senza, da Android 11 TextToSpeech non vede nessun motore. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 0.7.2: il riconoscitore vocale di sistema per la dettatura in chat. Registra la sua activity,
             non Argus: nessun permesso RECORD_AUDIO. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".ArgusApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Argus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Argus"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 0.7.2: riceve una regola da un'altra app (testo dal foglio di condivisione, file di backup da un
             file manager). Esportata per forza, quindi fa il minimo: mostra cosa è arrivato e, solo su conferma
             dell'utente in questa schermata, crea bozze da approvare con l'import esistente. Mai una regola
             armata. MainActivity resta l'unico launcher e non legge i dati degli Intent. -->
        <activity
            android:name=".importing.ImportRuleActivity"
            android:exported="true"
            android:label="@string/import_activity_label"
            android:theme="@style/Theme.Argus">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- 0.4.1 (F8): trampolino invisibile di scorciatoie Home e pulsanti del widget. NON esportato:
             lo avvia solo il sistema per conto di Argus, e ogni avvio verifica il token della regola. -->
        <activity
            android:name=".manual.ManualRunActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Argus.Trampoline" />

        <!-- 0.7.2: trampolino invisibile del tocco di un avviso di salute. NON esportato: lo avvia solo il
             PendingIntent della notifica di Argus; passa la schermata alla navigazione dentro il processo. -->
        <activity
            android:name=".nav.HealthAlertOpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Argus.Trampoline" />

        <!-- Riquadri delle impostazioni rapide: l'unico che puo' legarli e' il sistema (permesso di firma). -->
        <service
            android:name=".manual.ManualRuleTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_manual"
            android:label="@string/manual_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".manual.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pause"
            android:label="@string/pause_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Widget: esportato solo perche' il sistema deve poterlo aggiornare. Non esegue regole: i
             pulsanti aprono il trampolino non esportato con id e token. -->
        <receiver
            android:name=".manual.ManualWidgetProvider"
            android:exported="true"
            android:label="@string/manual_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/manual_widget_info" />
        </receiver>

        <service
            android:name=".manual.ManualWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>
