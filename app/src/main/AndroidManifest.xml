<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permission normal: consente a OkHttp/probe di interrogare ConnectivityManager. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- P1: dialogo diretto di esenzione batteria, aperto SOLO da gesto utente (CTA Settings/onboarding). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 0.4.1: «Modifica impostazioni di sistema» (permesso speciale, si concede solo dalle impostazioni
         di sistema): serve alle azioni luminosità e rotazione dello schermo. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- 0.4.1: package visibility per i motori di sintesi vocale (azione «leggi ad alta voce»);
         senza, da Android 11 TextToSpeech non vede nessun motore. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ArgusApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Argus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Argus"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 0.4.1 (F8): trampolino invisibile di scorciatoie Home e pulsanti del widget. NON esportato:
             lo avvia solo il sistema per conto di Argus, e ogni avvio verifica il token della regola. -->
        <activity
            android:name=".manual.ManualRunActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Argus.Trampoline" />

        <!-- Riquadri delle impostazioni rapide: l'unico che puo' legarli e' il sistema (permesso di firma). -->
        <service
            android:name=".manual.ManualRuleTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_manual"
            android:label="@string/manual_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".manual.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pause"
            android:label="@string/pause_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Widget: esportato solo perche' il sistema deve poterlo aggiornare. Non esegue regole: i
             pulsanti aprono il trampolino non esportato con id e token. -->
        <receiver
            android:name=".manual.ManualWidgetProvider"
            android:exported="true"
            android:label="@string/manual_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/manual_widget_info" />
        </receiver>

        <service
            android:name=".manual.ManualWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>
