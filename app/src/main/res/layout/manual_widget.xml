<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/manual_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/manual_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manual_widget_title"
        android:textColor="@color/argus_widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/manual_widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manual_widget_paused"
        android:textColor="@color/argus_widget_warn"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/manual_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp" />

        <TextView
            android:id="@+id/manual_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/manual_widget_empty"
            android:textColor="@color/argus_widget_muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
