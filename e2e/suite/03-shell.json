 {
  "id": "S05-shell-capture-notify",
  "title": "run_shell cattura l'output in una variabile e lo mostra in una notifica",
  "cond": "true",
  "rule": {
   "name": "S05-shell-capture-notify",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "run_shell",
     "cmd": "echo e2e-out-{{RUN}}",
     "captureAs": "out"
    },
    {
     "type": "show_notification",
     "title": "e2e S05 ${out}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e S05 e2e-out-{{RUN}}'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.run_shell"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
 {
  "id": "S06-shell-from-sms-refused",
  "title": "Una shell non puo' partire da un SMS",
  "cond": "none",
  "rule": {
   "name": "S06-shell-from-sms-refused",
   "trigger": {
    "type": "phone_state",
    "event": "SMS_RECEIVED"
   },
   "actions": [
    {
     "type": "run_shell",
     "cmd": "true"
    }
   ]
  },
  "expect": {
   "load": {
    "fail": {
     "stage": "review",
     "code": "shell_external_trigger"
    }
   }
  }
 },
