[
 {
  "id": "S01-shell-identity",
  "title": "run_shell gira con l'identita' di Shizuku (root = 0, shell = 2000)",
  "cond": "true",
  "rule": {
   "name": "S01-shell-identity",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "run_shell",
     "cmd": "id -u > /data/local/tmp/e2e_uid"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "rm -f /data/local/tmp/e2e_uid"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "cat /data/local/tmp/e2e_uid",
    "equals": "2000",
    "wait_s": 4
   }
  ],
  "cleanup": [
   "rm -f /data/local/tmp/e2e_uid"
  ],
  "per_config": {
   "shizuku_root": {
    "checks": [
     {
      "shell": "cat /data/local/tmp/e2e_uid",
      "equals": "0",
      "wait_s": 4
     }
    ]
   },
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.run_shell"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
