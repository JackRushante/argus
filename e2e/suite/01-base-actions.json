 },
 {
  "id": "A13-alarm-timer",
  "title": "Sveglia e timer reali",
  "cond": "true",
  "rule": {
   "name": "A13-alarm-timer",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "set_alarm",
     "hour": 6,
     "minute": 30,
     "label": "e2e {{RUN}}",
     "skipUi": true
    },
    {
     "type": "set_timer",
     "seconds": 600,
     "label": "e2e {{RUN}}",
     "skipUi": true
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "SUCCEEDED",
    "actions": [
     "set_alarm:SUCCEEDED",
     "set_timer:SUCCEEDED"
    ]
   }
  },
  "needs": [
   "package:com.google.android.deskclock"
  ]
 },
 {
  "id": "A14-http-ok",
  "title": "Richiesta HTTP GET riuscita",
  "cond": "true",
  "rule": {
   "name": "A14-http-ok",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "http_request",
     "method": "GET",
     "url": "https://example.com/"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "needs": [
   "internet"
  ]
 },
 {
  "id": "A15-http-404",
  "title": "Richiesta HTTP: il codice 404 e' registrato nel journal",
  "cond": "true",
  "rule": {
   "name": "A15-http-404",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "http_request",
     "method": "GET",
     "url": "https://example.com/e2e-not-found"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "FAILED",
    "actions": [
     "http_request:FAILED:http_status_404"
    ]
   }
  },
  "needs": [
   "internet"
  ],
  "fire": {
   "payload": {}
  }
 },
 {
  "id": "A16-http-network",
  "title": "Richiesta HTTP: errore di rete",
  "cond": "true",
  "rule": {
   "name": "A16-http-network",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "http_request",
     "method": "GET",
     "url": "https://localhost:9/"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "FAILED",
    "actions": [
     "http_request:FAILED:http_network_error"
    ]
   }
  }
 },
 {
  "id": "A17-http-post-json",
  "title": "Richiesta HTTP POST con corpo JSON",
  "cond": "true",
  "rule": {
   "name": "A17-http-post-json",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "http_request",
     "method": "POST",
     "url": "https://example.com/",
     "headers": {
      "Accept": "text/html"
     },
     "body": "{\"e2e\":\"{{RUN}}\"}",
     "contentType": "application/json"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "executions": 1
   }
  },
  "needs": [
   "internet"
  ],
  "fire": {
   "payload": {}
  }
 }
]
