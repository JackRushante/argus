    "type": "manual"
   },
   "actions": [
    {
     "type": "open_settings_screen",
     "screen": "WIFI"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
