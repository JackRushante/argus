  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "checks": [
   {
    "shell": "dumpsys activity activities | grep -E 'topResumedActivity'",
    "contains": "chrome",
    "wait_s": 6
   }
  ]
 },
 {
  "id": "A12-settings-screen",
  "title": "Apre la schermata Wi-Fi delle Impostazioni",
