     "type": "if",
     "condition": {
      "type": "var_compare",
      "varName": "n",
      "op": "LT",
      "expected": "3"
     },
     "then": [
      {
       "type": "show_notification",
       "title": "e2e F05 then {{RUN}}",
       "text": "e2e body"
      }
     ],
     "orElse": [
      {
       "type": "show_notification",
       "title": "e2e F05 else {{RUN}}",
       "text": "e2e body"
      }
     ]
    }
   ],
   "vars": [
    {
     "type": "literal",
     "name": "n",
     "value": "5",
     "varType": "NUMBER",
     "confidentiality": "PUBLIC"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F05 else {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   },
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F05 then {{RUN}})'",
    "equals": "0",
    "wait_s": 0
   }
  ]
 },
 {
  "id": "F06-random-even",
  "title": "P4: random_int(1) vale sempre 0, quindi pari",
  "cond": "true",
  "rule": {
   "name": "F06-random-even",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "if",
     "condition": {
      "type": "var_compare",
      "varName": "r",
      "op": "IS_EVEN"
     },
     "then": [
      {
       "type": "show_notification",
       "title": "e2e F06 even {{RUN}}",
       "text": "e2e body"
      }
     ],
     "orElse": [
      {
       "type": "show_notification",
       "title": "e2e F06 odd {{RUN}}",
       "text": "e2e body"
      }
     ]
    }
   ],
   "vars": [
    {
     "type": "random_int",
     "name": "r",
     "max": 1
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F06 even {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   },
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F06 odd {{RUN}})'",
    "equals": "0",
    "wait_s": 0
   }
  ]
 },
 {
  "id": "F07-while-literal",
  "title": "P4: while con 3 giri e pausa fra i giri",
  "cond": "true",
  "rule": {
   "name": "F07-while-literal",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "while",
     "condition": {
      "type": "boolean_literal",
      "value": true
     },
     "body": [
      {
       "type": "vibrate",
       "durationMs": 50
      }
     ],
     "maxIterations": 3,
     "delayBetweenMs": 200
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "SUCCEEDED",
    "actions_contain": [
     "vibrate:SUCCEEDED"
    ]
   }
  },
  "fire": {
   "payload": {}
  }
 },
 {
  "id": "F08-while-var-count",
  "title": "P4: while con numero di giri da una variabile",
  "cond": "true",
  "rule": {
   "name": "F08-while-var-count",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "while",
     "condition": {
      "type": "boolean_literal",
      "value": true
     },
     "body": [
      {
       "type": "vibrate",
       "durationMs": 50
      }
     ],
     "maxIterationsVar": "k",
     "delayBetweenMs": 100
    }
   ],
   "vars": [
    {
     "type": "literal",
     "name": "k",
     "value": "2",
     "varType": "NUMBER",
     "confidentiality": "PUBLIC"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "SUCCEEDED",
    "actions_contain": [
     "vibrate:SUCCEEDED"
    ]
   }
  }
 },
 {
  "id": "F09-wait",
  "title": "P4: attesa di 1,5 secondi fra due notifiche",
  "cond": "true",
  "rule": {
   "name": "F09-wait",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e F09 a {{RUN}}",
     "text": "e2e body"
    },
    {
     "type": "wait",
     "durationMs": 1500
    },
    {
     "type": "show_notification",
     "title": "e2e F09 b {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "SUCCEEDED",
    "actions_contain": [
     "wait:SUCCEEDED"
    ]
   }
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F09 a {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   },
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F09 b {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "F10-state-var",
  "title": "P4: variabile da lettore di stato (batteria) con if",
  "cond": "none",
  "rule": {
   "name": "F10-state-var",
   "trigger": {
    "type": "screen",
    "event": "UNLOCKED"
   },
   "actions": [
    {
     "type": "if",
     "condition": {
      "type": "var_compare",
      "varName": "level",
      "op": "GT",
      "expected": "10"
     },
     "then": [
      {
       "type": "show_notification",
       "title": "e2e F10 {{RUN}}",
       "text": "e2e body"
      }
     ]
    }
   ],
   "vars": [
    {
     "type": "state",
     "name": "level",
     "query": {
      "type": "builtin",
      "key": "battery"
     },
     "valueType": "NUMBER",
     "policyVersion": 1,
     "confidentiality": "PRIVATE"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "dumpsys battery reset"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F10 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "state.reader.builtin"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
 {
  "id": "F11-payload-var",
  "title": "P4: il codice dell'SMS in una variabile, copiato negli appunti",
  "cond": "none",
  "rule": {
   "name": "F11-payload-var",
   "trigger": {
    "type": "phone_state",
    "event": "SMS_RECEIVED",
    "textMatch": "codice"
   },
   "actions": [
    {
     "type": "copy_text",
     "text": "${code}"
    },
    {
     "type": "show_notification",
     "title": "e2e F11 done {{RUN}}",
     "text": "e2e body"
    }
   ],
   "vars": [
    {
     "type": "trigger_payload",
     "name": "code",
     "field": "TEXT",
     "extractionRegex": "(\\d{6})",
     "confidentiality": "PRIVATE"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {
    "text": "Il tuo codice 123456 scade"
   }
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F11 done {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "F12-nested-if-while",
  "title": "P4: if dentro while, ramo falso",
  "cond": "true",
  "rule": {
   "name": "F12-nested-if-while",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "while",
     "condition": {
      "type": "boolean_literal",
      "value": true
     },
     "maxIterations": 2,
     "delayBetweenMs": 0,
     "body": [
      {
       "type": "if",
       "condition": {
        "type": "boolean_literal",
        "value": false
       },
       "then": [
        {
         "type": "vibrate",
         "durationMs": 50
        }
       ],
       "orElse": [
        {
         "type": "set_rotation",
         "auto": true
        }
       ]
      }
     ]
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "SUCCEEDED",
    "actions_contain": [
     "set_rotation:SUCCEEDED"
    ]
   }
  },
  "fire": {
   "payload": {}
  }
 },
 {
  "id": "F13-shell-while-capture",
  "title": "P4: shell in un ciclo, output in una variabile (poi notifica)",
  "cond": "true",
  "rule": {
   "name": "F13-shell-while-capture",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "while",
     "condition": {
      "type": "boolean_literal",
      "value": true
     },
     "maxIterations": 1,
     "delayBetweenMs": 0,
     "body": [
      {
       "type": "run_shell",
       "cmd": "echo loop-{{RUN}}",
       "captureAs": "o"
      },
      {
       "type": "show_notification",
       "title": "e2e F13 ${o}",
       "text": "e2e body"
      }
     ]
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F13 loop-{{RUN}}'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.run_shell"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
 {
  "id": "F14-flow-privileged-radios",
  "title": "P4: if su una variabile con due azioni privilegiate",
  "cond": "true",
  "rule": {
   "name": "F14-flow-privileged-radios",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "if",
     "condition": {
      "type": "var_compare",
      "varName": "go",
      "op": "EQ",
      "expected": "yes"
     },
     "then": [
      {
       "type": "set_airplane",
       "on": true
      },
      {
       "type": "wait",
       "durationMs": 500
      },
      {
       "type": "set_airplane",
       "on": false
      }
     ]
    }
   ],
   "vars": [
    {
     "type": "literal",
     "name": "go",
     "value": "yes",
     "varType": "TEXT",
     "confidentiality": "PUBLIC"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "SUCCEEDED",
    "actions_contain": [
     "set_airplane:SUCCEEDED"
    ]
   }
  },
  "fire": {
   "payload": {}
  },
  "wait_s": 4,
  "checks": [
   {
    "shell": "settings get global airplane_mode_on",
    "equals": "0",
    "wait_s": 8
   }
  ],
  "cleanup": [
   "cmd connectivity airplane-mode disable"
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.set_airplane"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
 {
  "id": "F15-var-compare-outside-flow",
  "title": "P4: un confronto su variabile fuori da if/while e' rifiutato",
  "cond": "none",
  "rule": {
   "name": "F15-var-compare-outside-flow",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e F15",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "var_compare",
    "varName": "x",
    "op": "EQ",
    "expected": "1"
   },
   "vars": [
    {
     "type": "literal",
     "name": "x",
     "value": "1",
     "varType": "TEXT",
     "confidentiality": "PUBLIC"
    }
   ]
  },
  "expect": {
   "load": {
    "fail": {
     "stage": "review",
     "code": "var_compare_outside_flow"
    }
   }
  }
 },
 {
  "id": "F16-undeclared-var",
  "title": "P4: una variabile non dichiarata e' rifiutata",
  "cond": "none",
  "rule": {
   "name": "F16-undeclared-var",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e F16 ${ghost}",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": {
    "fail": {
     "stage": "review",
     "code": "interpolation_undeclared_var"
    }
   }
  }
 },
 {
  "id": "F17-wait-invalid",
  "title": "P4: attesa negativa rifiutata",
  "cond": "none",
  "rule": {
   "name": "F17-wait-invalid",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "wait",
     "durationMs": -5
    },
    {
     "type": "show_notification",
     "title": "e2e F17",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": {
    "fail": {
     "stage": "review",
     "code": "wait_duration_invalid"
    }
   }
  }
 }
]
