[
 {
  "id": "F01-literal-var",
  "title": "P4: variabile letterale nel testo di una notifica",
  "cond": "true",
  "rule": {
   "name": "F01-literal-var",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e F01 ${tag}",
     "text": "x"
    }
   ],
   "vars": [
    {
     "type": "literal",
     "name": "tag",
     "value": "{{RUN}}",
     "varType": "TEXT",
     "confidentiality": "PUBLIC"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F01 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "F02-clock-var",
  "title": "P4: l'ora corrente (clock) in una notifica",
  "cond": "true",
  "rule": {
   "name": "F02-clock-var",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e F02 ${now}",
     "text": "x"
    }
   ],
   "vars": [
    {
     "type": "clock",
     "name": "now",
     "tz": "Europe/Rome",
     "pattern": "yyyy"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F02 2026)'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "F03-clock-tokyo",
  "title": "P4: clock in un altro fuso, formato personalizzato",
  "cond": "true",
  "rule": {
   "name": "F03-clock-tokyo",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e F03 ${d}",
     "text": "x"
    }
   ],
   "vars": [
    {
     "type": "clock",
     "name": "d",
     "tz": "Asia/Tokyo",
     "pattern": "yyyy-MM"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F03 2026-'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "F04-if-then",
  "title": "P4: if con confronto numerico vero",
  "cond": "true",
  "rule": {
   "name": "F04-if-then",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "if",
     "condition": {
      "type": "var_compare",
      "varName": "n",
      "op": "GT",
      "expected": "3"
     },
     "then": [
      {
       "type": "show_notification",
       "title": "e2e F04 then {{RUN}}",
       "text": "e2e body"
      }
     ],
     "orElse": [
      {
       "type": "show_notification",
       "title": "e2e F04 else {{RUN}}",
       "text": "e2e body"
      }
     ]
    }
   ],
   "vars": [
    {
     "type": "literal",
     "name": "n",
     "value": "5",
     "varType": "NUMBER",
     "confidentiality": "PUBLIC"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F04 then {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   },
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e F04 else {{RUN}})'",
    "equals": "0",
    "wait_s": 0
   }
  ]
 },
 {
  "id": "F05-if-else",
