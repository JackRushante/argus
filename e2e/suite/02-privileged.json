 {
  "id": "B14-permission-grant",
  "title": "Concede un permesso a un'app",
  "cond": "true",
  "rule": {
   "name": "B14-permission-grant",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "app_permission",
     "pkg": "com.google.android.calendar",
     "permission": "android.permission.READ_CALENDAR",
     "grant": true
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "pm revoke com.google.android.calendar android.permission.READ_CALENDAR"
  ],
  "checks": [
   {
    "shell": "dumpsys package com.google.android.calendar | grep 'android.permission.READ_CALENDAR: granted' | head -1",
    "contains": "granted=true",
    "wait_s": 4
   }
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.app_permission"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
 {
  "id": "B15-permission-revoke",
  "title": "Revoca un permesso a un'app",
  "cond": "true",
  "rule": {
   "name": "B15-permission-revoke",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "app_permission",
     "pkg": "com.google.android.calendar",
     "permission": "android.permission.READ_CALENDAR",
     "grant": false
