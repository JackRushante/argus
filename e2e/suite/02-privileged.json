 {
  "id": "B11-app-force-stop",
  "title": "Arresto forzato di un'app",
  "cond": "true",
  "rule": {
   "name": "B11-app-force-stop",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "app_control",
     "pkg": "com.google.android.contacts",
     "op": "FORCE_STOP"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "monkey -p com.google.android.contacts -c android.intent.category.LAUNCHER 1"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys package com.google.android.contacts | grep -o 'stopped=[a-z]*'",
    "contains": "stopped=true",
    "wait_s": 5
   }
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.app_control"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
