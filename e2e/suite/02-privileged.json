 {
  "id": "B10-screenshot",
  "title": "Schermata salvata in Pictures/Argus",
  "cond": "true",
  "rule": {
   "name": "B10-screenshot",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "screenshot"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
