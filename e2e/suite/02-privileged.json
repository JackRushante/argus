[
 {
  "id": "B01-wifi-off",
  "title": "Wi-Fi spento",
  "cond": "true",
  "rule": {
   "name": "B01-wifi-off",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "set_wifi",
     "on": false
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "svc wifi enable"
  ],
  "wait_s": 3,
  "checks": [
   {
    "shell": "settings get global wifi_on",
    "equals": "0",
    "wait_s": 8
   }
  ],
  "cleanup": [
   "svc wifi enable"
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.set_wifi"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
