   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "pm grant com.google.android.calendar android.permission.READ_CALENDAR"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys package com.google.android.calendar | grep 'android.permission.READ_CALENDAR: granted' | head -1",
    "contains": "granted=false",
    "wait_s": 4
   }
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "action.app_permission"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
