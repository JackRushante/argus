 {
  "id": "B09-lock-screen",
  "title": "Blocco dello schermo",
  "cond": "true",
  "rule": {
   "name": "B09-lock-screen",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "lock_screen"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "on"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
