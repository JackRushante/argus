 {
  "id": "B08-battery-saver",
  "title": "Risparmio energetico (a batteria scollegata)",
  "cond": "true",
  "rule": {
   "name": "B08-battery-saver",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "set_battery_saver",
     "on": true
    }
   ],
   "conditions": {
    "type": "state_equals",
