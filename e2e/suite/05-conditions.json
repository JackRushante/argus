 {
  "id": "C03-wifi-airplane-and",
  "title": "Condizione: Wi-Fi acceso E aereo spento (vera)",
  "cond": "true",
  "rule": {
   "name": "C03-wifi-airplane-and",
   "trigger": {
    "type": "manual"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e C03 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "and",
    "all": [
     {
      "type": "state_equals",
      "key": "wifi",
      "op": "EQ",
      "value": "on"
     },
     {
      "type": "state_equals",
      "key": "airplane",
      "op": "EQ",
      "value": "off"
     }
    ]
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "svc wifi enable"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e C03 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "C04-or",
  "title": "Condizione: O (una vera e una falsa) e' vera",
  "cond": "true",
  "rule": {
   "name": "C04-or",
   "trigger": {
    "type": "mode_changed",
    "what": "RINGER"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e C04 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "or",
    "any": [
     {
      "type": "state_equals",
      "key": "dnd",
      "op": "EQ",
      "value": "total"
     },
     {
      "type": "state_equals",
      "key": "screen",
      "op": "EQ",
      "value": "on"
     }
    ]
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "input keyevent KEYCODE_WAKEUP"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e C04 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "C05-not-false",
  "title": "Condizione: NON (vera) e' falsa",
  "cond": "false",
  "rule": {
   "name": "C05-not-false",
   "trigger": {
    "type": "media",
    "state": "STOPPED"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e C05 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "not",
    "cond": {
     "type": "state_equals",
     "key": "airplane",
     "op": "EQ",
     "value": "off"
    }
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "executions": 0,
    "audit_has": [
     "CONDITIONS_NOT_MET"
    ]
   }
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e C05 {{RUN}})'",
    "equals": "0",
    "wait_s": 0
   }
  ]
 },
 {
  "id": "C06-battery-compare-true",
  "title": "Condizione: batteria > 10 (lettore integrato, vera)",
  "cond": "true",
  "rule": {
   "name": "C06-battery-compare-true",
   "trigger": {
    "type": "connectivity",
    "medium": "POWER",
    "state": "CONNECTED"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e C06 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "state_compare",
    "query": {
     "type": "builtin",
     "key": "battery"
    },
    "valueType": "NUMBER",
    "op": "GT",
    "expected": "10",
    "policyVersion": 1
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "dumpsys battery reset"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e C06 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable",
       "detail": "state.reader.builtin"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
