 {
  "id": "C15-location-unknown-fails-closed",
  "title": "Condizione: posizione sconosciuta fallisce chiusa anche sotto NOT",
  "cond": "false",
  "rule": {
   "name": "C15-location-unknown-fails-closed",
   "trigger": {
    "type": "time",
    "at": "2027-03-14T09:31",
    "tz": "Europe/Rome"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e C15 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "not",
    "cond": {
     "type": "location_in",
     "lat": 0.5,
     "lng": 0.5,
     "radiusM": 100.0
    }
   }
  },
  "expect": {
   "load": "ok",
   "run": {
    "executions": 0,
    "audit_has": [
     "CONDITIONS_NOT_MET"
    ]
   }
  },
  "pre": [
   "cmd location set-location-enabled false"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e C15 {{RUN}})'",
    "equals": "0",
    "wait_s": 0
   }
  ],
  "cleanup": [
