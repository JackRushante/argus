 {
  "id": "C08-time-window-true",
  "title": "Condizione: finestra oraria che contiene adesso (vera)",
  "cond": "true",
  "rule": {
   "name": "C08-time-window-true",
   "trigger": {
    "type": "time",
    "cron": "0 9 * * *",
    "tz": "Europe/Rome"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e C08 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "time_window",
    "startLocal": "00:00",
    "endLocal": "23:59",
    "tz": "Europe/Rome"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e C08 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
