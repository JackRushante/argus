[
 {
  "id": "C01-ringer-true",
  "title": "Condizione: suoneria normale (vera)",
  "cond": "true",
  "rule": {
   "name": "C01-ringer-true",
   "trigger": {
    "type": "screen",
    "event": "ON"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e C01 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "ringer",
    "op": "EQ",
    "value": "normal"
   }
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "cmd audio set-ringer-mode NORMAL",
   "cmd notification set_dnd off"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e C01 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "cleanup": [
   "cmd audio set-ringer-mode NORMAL",
   "cmd notification set_dnd off"
  ]
 },
