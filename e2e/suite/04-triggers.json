 {
  "id": "T34-sensor-unavailable",
  "title": "Sensore di movimento significativo: assente sull'emulatore",
  "cond": "none",
  "rule": {
   "name": "T34-sensor-unavailable",
   "trigger": {
    "type": "sensor",
    "kind": "significant_motion"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T34",
     "text": "e2e body"
    }
   ],
   "cooldownMs": 60000
  },
  "expect": {
   "load": {
    "fail": {
     "stage": "review",
     "code": "capability_unavailable",
     "detail": "trigger.sensor.significant_motion"
    }
   }
  }
 }
]
