[
 {
  "id": "T01-time-after-ms",
  "title": "Tempo: fra 3 secondi (allarme esatto vero)",
  "cond": "none",
  "rule": {
   "name": "T01-time-after-ms",
   "trigger": {
    "type": "time",
    "afterMs": 3000,
    "tz": "Europe/Rome",
    "precision": "EXACT"
   },
   "actions": [
    {
     "type": "set_ringer",
     "mode": "vibrate"
    },
    {
     "type": "show_notification",
     "title": "e2e T01 {{RUN}}",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "cmd audio set-ringer-mode NORMAL",
   "cmd notification set_dnd off"
  ],
  "wait_s": 6,
  "checks": [
   {
    "shell": "dumpsys audio | grep -A2 'Ringer mode'",
    "contains": "mode (external) = VIBRATE",
    "wait_s": 4
   },
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T01 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "cleanup": [
   "cmd audio set-ringer-mode NORMAL",
   "cmd notification set_dnd off"
  ]
 },
 {
  "id": "T02-time-cron",
