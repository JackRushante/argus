 {
  "id": "T16-audio-bluetooth",
  "title": "Cuffie Bluetooth collegate (evento sintetico)",
  "cond": "none",
  "rule": {
   "name": "T16-audio-bluetooth",
   "trigger": {
    "type": "audio_output",
    "kind": "BLUETOOTH",
    "state": "CONNECTED"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T16 {{RUN}}",
     "text": "e2e body"
    },
    {
     "type": "set_volume",
     "stream": "MEDIA",
     "level": 30
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "cmd media_session volume --stream 3 --set 1"
  ],
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T16 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   },
   {
    "shell": "cmd media_session volume --stream 3 --get | tail -1",
    "contains": "volume is 5 in",
    "wait_s": 3
   }
  ],
  "cleanup": [
   "cmd media_session volume --stream 3 --set 7"
  ]
 },
