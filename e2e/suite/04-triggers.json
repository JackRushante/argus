 },
 {
  "id": "T28-sms",
  "title": "SMS ricevuto da un numero con testo (evento sintetico)",
  "cond": "none",
  "rule": {
   "name": "T28-sms",
   "trigger": {
    "type": "phone_state",
    "event": "SMS_RECEIVED",
    "number": "+393331112222",
    "textMatch": "otp"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T28 {{RUN}}",
     "text": "e2e body"
    },
    {
     "type": "copy_to_clipboard",
     "extractionRegex": "(\\d{4,8})"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {
    "text": "OTP 556677"
   }
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T28 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
