 {
  "id": "T04-time-solar",
  "title": "Tempo: alba con scostamento (posizione simulata, evento sintetico)",
  "cond": "none",
  "rule": {
   "name": "T04-time-solar",
   "trigger": {
    "type": "time",
    "solar": {
     "event": "SUNRISE",
     "offsetMinutes": 30
    },
    "tz": "Europe/Rome"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T04 {{RUN}}",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T04 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "pre": [
   "appops set com.android.shell android:mock_location allow",
   "asshell 'for p in fused network gps; do cmd location providers add-test-provider $p; cmd location providers set-test-provider-enabled $p true; cmd location providers set-test-provider-location $p --location 45.46,9.19 --accuracy 10; done'"
  ],
  "cleanup": [
   "asshell 'for p in fused network gps; do cmd location providers remove-test-provider $p; done'",
   "cmd location set-location-enabled false",
   "cmd location set-location-enabled true"
  ]
 },
 {
  "id": "T05-immediate",
  "title": "Subito: parte una sola volta e si disattiva",
  "cond": "none",
  "rule": {
   "name": "T05-immediate",
   "trigger": {
    "type": "immediate"
   },
   "actions": [
    {
     "type": "set_ringer",
     "mode": "silent"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": {
    "status": "SUCCEEDED",
    "audit_has": [
     "FIRED",
     "RULE_DISABLED"
    ]
   }
  },
  "pre": [
   "cmd audio set-ringer-mode NORMAL",
   "cmd notification set_dnd off"
  ],
  "checks": [
   {
    "shell": "dumpsys audio | grep -A2 'Ringer mode'",
    "contains": "mode (external) = SILENT",
    "wait_s": 4
   }
  ],
  "cleanup": [
   "cmd audio set-ringer-mode NORMAL",
   "cmd notification set_dnd off"
  ]
 },
