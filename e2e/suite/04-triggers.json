 {
  "id": "T23-app-closed",
  "title": "App chiusa (evento sintetico)",
  "cond": "none",
  "rule": {
   "name": "T23-app-closed",
   "trigger": {
    "type": "app_event",
    "pkg": "com.google.android.deskclock",
    "event": "CLOSED"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T23 {{RUN}}",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T23 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
 {
  "id": "T24-notification-real",
  "title": "Notifica ricevuta (ne posto una davvero) e codice negli appunti",
  "cond": "none",
  "rule": {
   "name": "T24-notification-real",
   "trigger": {
    "type": "notification",
    "pkg": "com.android.shell",
    "titleMatch": "e2e-in-{{RUN}}"
   },
   "actions": [
    {
     "type": "copy_to_clipboard",
     "extractionRegex": "(\\d{6})"
    },
    {
     "type": "show_notification",
     "title": "e2e T24 {{RUN}}",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "real": [
    "asshell \"cmd notification post -S bigtext -t 'e2e-in-{{RUN}}' e2etag 'Your code is 482913'\""
   ],
   "settle_s": 3
  },
  "wait_s": 4,
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T24 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
