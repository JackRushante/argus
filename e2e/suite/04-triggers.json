 {
  "id": "T10-battery-below-real",
  "title": "Batteria sotto il 20 % (livello reale con dumpsys battery)",
  "cond": "none",
  "rule": {
   "name": "T10-battery-below-real",
   "trigger": {
    "type": "battery",
    "below": 20
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T10 {{RUN}}",
     "text": "e2e body"
    },
    {
     "type": "set_brightness",
     "level": 10
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "pre": [
   "dumpsys battery reset"
  ],
  "fire": {
   "real": [
    "dumpsys battery set level 15"
   ],
   "settle_s": 3
  },
  "wait_s": 3,
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T10 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ],
  "cleanup": [
   "dumpsys battery reset",
   "settings put system screen_brightness_mode 1",
   "settings put system screen_brightness 128"
  ]
 },
