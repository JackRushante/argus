 {
  "id": "T07-screen-on-real",
  "title": "Schermo acceso (spegni e riaccendi davvero)",
  "cond": "none",
  "rule": {
   "name": "T07-screen-on-real",
   "trigger": {
    "type": "screen",
    "event": "ON"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T07 {{RUN}}",
     "text": "e2e body"
    },
    {
     "type": "vibrate",
     "durationMs": 100
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "real": [
    "input keyevent KEYCODE_SLEEP",
    2,
    "input keyevent KEYCODE_WAKEUP",
    "wm dismiss-keyguard"
   ]
  },
  "wait_s": 3,
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T07 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 },
