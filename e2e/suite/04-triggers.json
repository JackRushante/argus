 {
  "id": "T26-notification-group-ignored",
  "title": "Notifica di gruppo: la regola 1:1 non scatta",
  "cond": "none",
  "rule": {
   "name": "T26-notification-group-ignored",
   "trigger": {
    "type": "notification",
    "pkg": "com.example.chat",
    "conversationId": "e2e-chat-1",
    "isGroup": false
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T26 {{RUN}}",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": {
    "executions": 0
   }
  },
  "fire": {
   "payload": {
    "isGroup": true
   }
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e T26 {{RUN}})'",
    "equals": "0",
    "wait_s": 0
   }
  ]
 },
 {
  "id": "T27-notification-sender-text",
  "title": "Notifica per mittente e testo (evento sintetico)",
  "cond": "none",
