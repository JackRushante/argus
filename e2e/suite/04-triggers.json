 {
  "id": "T32-sim-filter",
  "title": "Filtro SIM: l'emulatore ha una sola SIM, la regola non si arma",
  "cond": "none",
  "rule": {
   "name": "T32-sim-filter",
   "trigger": {
    "type": "phone_state",
    "event": "INCOMING_CALL",
    "sim": 2
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e T32",
     "text": "e2e body"
    }
   ]
  },
  "expect": {
   "load": {
    "fail": {
     "stage": "review",
     "code": "capability_unavailable",
     "detail": "trigger.phone_state.sim"
    }
   }
  }
 },
