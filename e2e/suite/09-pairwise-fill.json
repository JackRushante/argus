[
 {
  "id": "Z01-geofence-false-audio_mode+display+launch+shell",
  "title": "Copertura a coppie: geofence / condizione false / audio_mode, display, launch, shell / capture+vars",
  "cond": "false",
  "rule": {
   "name": "Z01-geofence-false-audio_mode+display+launch+shell",
   "trigger": {
    "type": "geofence",
    "lat": 41.9,
    "lng": 12.5,
    "radiusM": 300.0,
    "transition": "EXIT"
   },
   "actions": [
    {
     "type": "set_volume",
     "stream": "MEDIA",
     "level": 30
    },
    {
     "type": "set_rotation",
     "auto": true
    },
    {
     "type": "set_timer",
     "seconds": 600,
     "label": "e2e fill",
     "skipUi": true
    },
    {
     "type": "run_shell",
     "cmd": "echo fill",
     "captureAs": "cap"
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "off"
   },
   "vars": [
    {
     "type": "literal",
     "name": "v",
     "value": "e2e",
     "varType": "TEXT",
     "confidentiality": "PUBLIC"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": {
    "executions": 0,
    "audit_has": [
     "CONDITIONS_NOT_MET"
    ]
   }
  },
  "fire": {
   "payload": {}
  },
  "cleanup": [
   "cmd media_session volume --stream 3 --set 7"
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
 {
  "id": "Z02-notification-false-device_control+network_out+radios",
  "title": "Copertura a coppie: notification / condizione false / device_control, network_out, radios / clock+while",
  "cond": "false",
  "rule": {
   "name": "Z02-notification-false-device_control+network_out+radios",
   "trigger": {
    "type": "notification",
    "pkg": "com.example.chat",
    "conversationId": "e2e-fill",
    "isGroup": false
   },
   "actions": [
    {
     "type": "while",
     "condition": {
      "type": "boolean_literal",
      "value": true
     },
     "body": [
      {
       "type": "screenshot"
      }
     ],
     "maxIterations": 1,
     "delayBetweenMs": 0
    },
    {
     "type": "http_request",
     "method": "GET",
     "url": "https://example.com/"
    },
    {
     "type": "set_wifi",
     "on": true
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "off"
   },
   "vars": [
    {
     "type": "clock",
     "name": "clk",
     "tz": "Europe/Rome",
     "pattern": "HH:mm"
    }
   ]
  },
  "expect": {
   "load": "ok",
   "run": {
    "executions": 0,
    "audit_has": [
     "CONDITIONS_NOT_MET"
    ]
   }
  },
  "needs": [
   "internet"
  ],
  "fire": {
   "payload": {}
  },
  "cleanup": [
   "rm -rf /sdcard/Pictures/Argus"
  ],
  "per_config": {
   "none": {
    "expect": {
     "load": {
      "fail": {
       "stage": "review",
       "code": "capability_unavailable"
      }
     }
    },
    "checks": [],
    "cleanup": []
   }
  }
 },
