     "code": "ui_steps_external_trigger"
    }
   }
  }
 },
 {
  "id": "P07-nfc_tag-unavailable-every-class",
  "title": "Tag NFC: l'emulatore non ha l'NFC, quindi il trigger non e' armabile (ogni classe di azione)",
  "cond": "none",
  "rule": {
   "name": "P07-nfc_tag-unavailable-every-class",
   "trigger": {
    "type": "nfc_tag",
    "tagId": "04:E2:E0:00:00:00:01"
   },
   "actions": [
    {
     "type": "vibrate",
     "durationMs": 100
    },
    {
     "type": "set_volume",
     "stream": "MEDIA",
     "level": 30
    },
    {
     "type": "set_rotation",
     "auto": true
    },
    {
     "type": "set_timer",
     "seconds": 600,
     "label": "e2e fill",
     "skipUi": true
    },
    {
     "type": "http_request",
     "method": "GET",
     "url": "https://example.com/"
    },
    {
     "type": "set_wifi",
     "on": true
    },
    {
     "type": "screenshot"
    },
    {
     "type": "run_shell",
     "cmd": "true"
    },
    {
     "type": "ui_steps",
     "steps": [
      {
       "op": "home"
      }
     ]
    }
   ]
  },
  "expect": {
   "load": {
    "fail": {
     "stage": "review",
     "code": "capability_unavailable",
     "detail": "trigger.nfc_tag"
    }
   }
  }
 },
 {
  "id": "P08-sensor-shake",
  "title": "Doppia scossa: armabile con l'accelerometro dell'emulatore (evento sintetico)",
  "cond": "none",
  "rule": {
   "name": "P08-sensor-shake",
   "trigger": {
    "type": "sensor",
    "kind": "shake"
   },
   "actions": [
    {
     "type": "show_notification",
     "title": "e2e P08 {{RUN}}",
     "text": "e2e body"
    }
   ],
   "cooldownMs": 60000
  },
  "expect": {
   "load": "ok",
   "run": "SUCCEEDED"
  },
  "fire": {
   "payload": {}
  },
  "checks": [
   {
    "shell": "dumpsys notification --noredact | grep -c 'android.title=String (e2e P08 {{RUN}})'",
    "matches": "^[1-9]",
    "wait_s": 4
   }
  ]
 }
]
