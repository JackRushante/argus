 {
  "id": "P06-app_usage-false-local_ui+screen_macro-refused",
  "title": "Tempo d'uso: una macro sullo schermo non puo' partire dall'uso di un'app",
  "cond": "false",
  "rule": {
   "name": "P06-app_usage-false-local_ui+screen_macro-refused",
   "trigger": {
    "type": "app_usage",
    "pkg": "com.google.android.deskclock",
    "minutes": 10
   },
   "actions": [
    {
     "type": "vibrate",
     "durationMs": 100
    },
    {
     "type": "ui_steps",
     "steps": [
      {
       "op": "home"
      }
     ]
    }
   ],
   "conditions": {
    "type": "state_equals",
    "key": "screen",
    "op": "EQ",
    "value": "off"
